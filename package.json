{
  "name": "pr-doorman",
  "version": "0.4.0",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "ncc build src/index.ts -o dist --license licenses.txt --minify",
    "all": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "github-action",
    "pull-request",
    "triage",
    "maintainers",
    "spam"
  ],
  "author": "Tanbir Hossain Ramim (https://github.com/TanbirRamim)",
  "license": "MIT",
  "description": "Rule-based, claim-aware pull request triage for GitHub. No AI.",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanbirRamim/pr-doorman.git"
  },
  "engines": {
    "node": ">=24"
  }
}
